# Copy to .env for local development. Never commit a filled-in .env.
# Every setting here maps 1:1 to a field on mlvoice.config.Settings.

# --- process ---------------------------------------------------------------
MLVOICE_ENV=development
MLVOICE_SERVICE_NAME=mlvoice
MLVOICE_LOG_LEVEL=INFO
MLVOICE_LOG_JSON=true

# --- auth ------------------------------------------------------------------
# Comma-separated API keys accepted by the service. Empty disables auth, which
# the service refuses to do when MLVOICE_ENV=production.
MLVOICE_API_KEYS=dev-local-key

# --- synthesis -------------------------------------------------------------
MLVOICE_TTS_BACKEND=dummy
MLVOICE_MODEL_ID=ai4bharat/IndicF5
# Pin the weights revision. Required in production: the IndicF5 family needs
# trust_remote_code, so an unpinned revision is remote code execution from a
# moving target. Leave commented out to run unpinned in development.
# MLVOICE_MODEL_REVISION=
MLVOICE_DEVICE=cpu
MLVOICE_SAMPLE_RATE=24000
MLVOICE_MAX_CHARS_PER_REQUEST=5000
MLVOICE_SYNTH_TIMEOUT_SECONDS=60

# --- transcription ---------------------------------------------------------
# Transcribe a reference clip when no transcript is supplied. Without this, a
# caller must type the transcript of their own recording, which is the main
# source of bad clones: a wrong transcript clones the voice correctly and
# garbles the words. Needs the 'models' extra; if it cannot load, transcription
# is disabled with a warning (and production refuses to start, because consent
# cannot be verified without it).
MLVOICE_ASR_ENABLED=true
# Load the recogniser at startup instead of on first use. Leave this off unless
# a readiness probe fronts the process: on a cold cache the default model is a
# 3 GB download, and doing it during startup holds the API, the web client and
# /healthz unreachable until it finishes. Production with consent enabled loads
# eagerly regardless, because it cannot verify consent without it.
MLVOICE_ASR_EAGER_LOAD=false
# An Indic-specific recogniser is materially better on Malayalam. See
# src/mlvoice/asr.py for candidates and the caveats on them. This default is
# ungated and dependable but a 3 GB download; openai/whisper-small is ~480 MB
# and worth using while getting a deployment working.
MLVOICE_ASR_MODEL_ID=openai/whisper-large-v3
# MLVOICE_ASR_REVISION=
MLVOICE_ASR_LANGUAGE=ml
MLVOICE_ASR_TRUST_REMOTE_CODE=false

# --- web client ------------------------------------------------------------
# Serves the browser UI at /ui. The page holds no secrets and every call it
# makes still needs an API key, but a public deployment may prefer not to
# advertise a cloning console at a guessable path.
MLVOICE_UI_ENABLED=true

# --- text frontend ---------------------------------------------------------
# Allophonic voicing of intervocalic stops. Dialect-sensitive; see
# docs/malayalam-linguistics.md before enabling.
MLVOICE_APPLY_INTERVOCALIC_VOICING=false
# Route Latin-script runs through the Manglish transliterator.
MLVOICE_TRANSLITERATE_LATIN=true

# --- storage ---------------------------------------------------------------
MLVOICE_DATABASE_URL=sqlite:///./data/mlvoice.db
# Reference audio and consent recordings. Biometric data: encrypt this volume
# and set a retention policy.
MLVOICE_VOICE_STORAGE_DIR=./data/voices

# --- limits ----------------------------------------------------------------
MLVOICE_RATE_LIMIT_PER_MINUTE=60
MLVOICE_MIN_REFERENCE_AUDIO_SECONDS=3
MLVOICE_MAX_REFERENCE_AUDIO_SECONDS=120

# --- safety ----------------------------------------------------------------
MLVOICE_REQUIRE_CONSENT=true
MLVOICE_WATERMARK_ENABLED=true
# Newline-delimited names refused at enrolment (public figures). Leave
# commented out to disable the check.
# MLVOICE_BLOCKED_VOICE_NAMES_FILE=./blocked-names.txt

# Long-lived secrets. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Rotating MLVOICE_WATERMARK_KEY makes previously generated audio undetectable.
MLVOICE_CONSENT_SIGNING_KEY=dev-consent-key
MLVOICE_WATERMARK_KEY=dev-watermark-key
